# ─── Model provider ───────────────────────────────────────────────
# Which LLM the agent uses: anthropic | openai | google | ollama | lmstudio
# Default: anthropic — first run works with just ANTHROPIC_AI_API_KEY set.
# MODEL_PROVIDER=anthropic

# Model ID for the chosen provider. Optional for hosted providers
# (defaults: anthropic claude-sonnet-4-6, openai gpt-4o-mini,
# google gemini-2.0-flash, ollama llama3.1). REQUIRED for lmstudio —
# set it to the model you loaded.
# MODEL_ID=

# ─── API keys (set the one for your provider) ─────────────────────
ANTHROPIC_AI_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# ─── Local model servers (only for ollama / lmstudio) ─────────────
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# ─── Server config ────────────────────────────────────────────────
# AGENT_PORT=3001
# CORS_ORIGIN=http://localhost:4200
