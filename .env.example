# ─── Model provider ───────────────────────────────────────────────
# Which LLM the agent uses: anthropic | openai | google | groq | bedrock | ollama | lmstudio
# Default: anthropic — first run works with just ANTHROPIC_AI_API_KEY set.
# MODEL_PROVIDER=anthropic

# Model ID for the chosen provider. Optional for hosted providers
# (defaults: anthropic claude-sonnet-4-6, openai gpt-4o-mini,
# google gemini-2.0-flash, groq qwen/qwen3.8-27b,
# bedrock us.anthropic.claude-haiku-4-5-20251001-v1:0, ollama llama3.1).
# REQUIRED for lmstudio —
# set it to the model you loaded.
# MODEL_ID=

# ─── API keys (set the one for your provider) ─────────────────────
ANTHROPIC_AI_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# GROQ_API_KEY=            # free tier: ~30 requests/min, ~1K requests/day, 1000 output tokens/min

# ─── Amazon Bedrock (only for bedrock) ────────────────────────────
# Auth resolves automatically: AWS_BEARER_TOKEN_BEDROCK (Bedrock API key)
# first, then SigV4 via AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
# Enable model access in the Bedrock console first; the default model uses a
# US cross-region inference profile, so your region must support it.
# AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Cap on output tokens per model call. Unset = provider default (recommended
# unless your provider rejects large requests). Groq's free tier caps output
# at 1000 tokens/min and rejects requests whose implicit budget exceeds it,
# so set 800 there.
# MAX_OUTPUT_TOKENS=

# ─── Local model servers (only for ollama / lmstudio) ─────────────
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# ─── Server config ────────────────────────────────────────────────
# AGENT_PORT=3001
# CORS_ORIGIN=http://localhost:4200
